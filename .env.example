[TEMPLATE]
# ============================================
# LegalCheck AI — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Supabase Configuration
# Get these from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Delivery Provider Configuration
# Options: 'demo' (default), 'shiprocket'
# 'demo' — deterministic mock provider for development/testing
# 'shiprocket' — real Shiprocket API (requires backend credentials)
VITE_DELIVERY_PROVIDER=demo

# Delivery Provider — Backend Credentials
# These are NEVER exposed to the frontend (no VITE_ prefix).
# Only needed when DELIVERY_PROVIDER=shiprocket
#
# DELIVERY_PROVIDER=demo
# SHIPROCKET_API_EMAIL=your-api-user-email@domain.com
# SHIPROCKET_API_PASSWORD=your-api-user-password
#
# Webhook security token (set in Shiprocket dashboard):
# SHIPROCKET_WEBHOOK_SECRET=your-webhook-secret-token
#
# Default pickup location name (must match a location configured in Shiprocket):
# SHIPROCKET_PICKUP_LOCATION=Primary

# ============================================
# IMPORTANT NOTES
# ============================================
#
# 1. The Google OAuth Client Secret must NEVER
#    be placed in frontend code. It is only used
#    in Supabase Dashboard → Authentication →
#    Providers → Google.
#
# 2. Supabase Dashboard setup required:
#    a. Go to Authentication → Providers → Google
#    b. Enable Google provider
#    c. Enter your Google OAuth Client ID and Secret
#    d. Add redirect URLs:
#       - http://localhost:5173 (or your VITE dev port)
#       - http://localhost:3000
#       - https://your-deployed-url.com
#
