{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://legalcheck-ai.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://legalcheck-ai.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}